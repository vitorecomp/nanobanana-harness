# ==============================================================================
# Nano Banana Studio — Environment Configuration (.env.example)
# ==============================================================================
# Universal Port Pad (`PORT_PAD`):
# Prefix applied to every host port in `podman-compose*.yml` and `docker-compose*.yml`:
#   - PORT_PAD=1 -> Nginx 18080, Frontend 13000, Backend 18000, Postgres 15432, RustFS 19000/19001
#   - PORT_PAD=2 -> Nginx 28080, Frontend 23000, Backend 28000, Postgres 25432, RustFS 29000/29001
#   - PORT_PAD=3 -> Nginx 38080, Frontend 33000, Backend 38000, Postgres 35432, RustFS 39000/39001
#
# Examples:
#   PORT_PAD=1 podman-compose -f podman-compose.dev.yml up -d
#   PORT_PAD=1 podman-compose -f podman-compose.yml up -d
#   PORT_PAD=2 docker-compose -f docker-compose.yml up -d
#
# Security Rule:
# Gemini / Nano Banana API Keys are NEVER configured in .env or sent to the
# backend. Users enter their Gemini API key exclusively in volatile browser RAM.
# ==============================================================================

# ------------------------------------------------------------------------------
# Universal Port Pad Prefix (`${PORT_PAD}8080`, `${PORT_PAD}3000`, `${PORT_PAD}8000`,
# `${PORT_PAD}5432`, `${PORT_PAD}9000`, `${PORT_PAD}9001`)
# ------------------------------------------------------------------------------
PORT_PAD=1

# ------------------------------------------------------------------------------
# PostgreSQL 16 Database
# ------------------------------------------------------------------------------
POSTGRES_USER=nanobanana
POSTGRES_PASSWORD=nanobanana
POSTGRES_DB=nanobanana

# ------------------------------------------------------------------------------
# RustFS S3-Compatible Object Storage
# ------------------------------------------------------------------------------
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
BUCKET_NAME=nanobanana-images

# ------------------------------------------------------------------------------
# Authentication Mode & Social OAuth (Google OAuth 2.0 & Facebook Login)
# - podman-compose.dev.yml / docker-compose.dev.yml default REQUIRE_AUTH=false
#   (auto-provisions usr_local_dev without mandatory login)
# - podman-compose.yml / docker-compose.yml default REQUIRE_AUTH=true
#   (enforces Google or Facebook login)
# ------------------------------------------------------------------------------
REQUIRE_AUTH=false
NEXT_PUBLIC_REQUIRE_AUTH=false
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=

# ------------------------------------------------------------------------------
# Frontend Backend URL Override (Leave empty when using Nginx reverse proxy
# or Next.js internal /api/* rewrite)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=
